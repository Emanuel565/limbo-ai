# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Schematic (optional for local development; app will fall back gracefully without them)
NEXT_PUBLIC_SCHEMATIC_PUBLISHABLE_KEY=api_your_schematic_publishable_key
SCHEMATIC_API_KEY=sch_dev_your_schematic_api_key

# Youtube API
YOUTUBE_API_KEY=your_youtube_api_key

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-convex-deployment # team: your-team, project: your-project

NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Chat AI provider
# Options: anthropic | openai | ollama
AI_PROVIDER=ollama

# Claude API (used when AI_PROVIDER=anthropic)
CLAUDE_API_KEY=sk-ant-api03-your_claude_api_key
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# OpenAI API (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Ollama local (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# TikTok Content Posting API v2
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id
TIKTOK_CREATOR_USERNAME=@seu_tiktok

# Instagram Graph API v19.0 (Reels Publishing)
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_USERNAME=@seu_instagram

